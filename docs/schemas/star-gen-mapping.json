{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noblefactor.com/schemas/star-gen-mapping/v1.0",
  "title": "Star-Gen Mapping",
  "description": "Machine-readable mapping of Go implementation structs to Starlark API operations. Generated by go.mapping().",
  "type": "object",
  "required": ["version", "struct", "package", "category", "namespace", "operations"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version."
    },
    "struct": {
      "type": "string",
      "description": "Go implementation struct name (e.g., 'fileOps')."
    },
    "package": {
      "type": "string",
      "description": "Go package name (e.g., 'execution')."
    },
    "category": {
      "type": "string",
      "description": "Operation category in snake_case (e.g., 'file')."
    },
    "namespace": {
      "type": "string",
      "description": "Dotted Starlark namespace (e.g., 'file' or 'plan.file')."
    },
    "operations": {
      "type": "array",
      "description": "List of operations mapped from Go methods.",
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "required": ["name", "go_method"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Fully qualified operation name (e.g., 'file.link')."
        },
        "go_method": {
          "type": "string",
          "description": "Go method name on the impl struct (e.g., 'Link')."
        },
        "params": {
          "type": "array",
          "description": "Parameters accepted by this operation.",
          "items": {
            "$ref": "#/$defs/param"
          }
        }
      }
    },
    "param": {
      "type": "object",
      "required": ["name", "type", "required"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Parameter name in snake_case."
        },
        "type": {
          "type": "string",
          "description": "Go type string (e.g., 'string', 'int', '[]string')."
        },
        "required": {
          "type": "boolean",
          "description": "Whether this parameter is required."
        },
        "source": {
          "type": "string",
          "description": "Where this parameter's value comes from if not from Starlark (e.g., 'context.data')."
        }
      }
    }
  }
}
