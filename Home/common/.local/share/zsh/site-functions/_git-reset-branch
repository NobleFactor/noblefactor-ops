_git-reset-branch() {
    local -a opts branches

    branches=(${(f)"$(git branch -a 2>/dev/null | sed 's/^[* ]*//' | sed 's|remotes/origin/||' | sort -u)"})

    opts=(
        '(-h --help)'{-h,--help}'[Show usage information and exit]'
        '(-r --reset)'{-r,--reset}'[Branch to reset]:branch:($branches)'
        '(-f --from)'{-f,--from}'[Source of truth to reset from]:branch:($branches)'
    )

    _arguments -s -S $opts
}

_git-reset-branch "$@"
