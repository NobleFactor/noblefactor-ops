#!/usr/bin/env bash
# shellcheck disable=SC2207,SC2034 # COMPREPLY and standard completion variables

# bash completion for git-reset-branch
# SPDX-License-Identifier: Apache-2.0
# Copyright (c) 2025-2026 Noble Factor. All rights reserved.

_git_reset_branch() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD - 1]}"

    opts="-h --help -r --reset -f --from"

    case "${prev}" in
        -r | --reset | -f | --from)
            # Complete with branch names
            local branches
            branches=$(git branch -a 2>/dev/null | sed 's/^[* ]*//' | sed 's|remotes/origin/||' | sort -u)
            COMPREPLY=($(compgen -W "${branches}" -- "${cur}"))
            return 0
            ;;
    esac

    if [[ ${cur} == -* ]]; then
        COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
        return 0
    fi

    return 0
}

complete -F _git_reset_branch git-reset-branch
